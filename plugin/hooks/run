#!/bin/sh
# The plugin's one hook shim: hand the event (and stdin) to this plugin's own launcher, never
# one on PATH (design/04 §2). With no launcher there it exits 0 silently, as a shim always has;
# `agentik session doctor` reports the gap.
# The switch (design/04 §3): one file, its existence the whole state, lapsing 24 h after its
# mtime. While on, a hook runs the launcher `install-cli` last wrote, as every hook did before
# sc2; RUNBOOK has the emergency's lines. Only HOME is read here: no other variable, PATH entry
# or settings `env` can select that launcher, so find is by its full path. A future mtime would
# never lapse, so it is refused; the [ -e ] forks nothing while the file is absent. `date` below
# stays by name: it selects nothing, and a wrong start only skews one row's figure.
tool=${CLAUDE_PLUGIN_ROOT}/bin/agentik-session; o=$HOME/.local/bin/agentik-session; f=$HOME/.config/agentik/hooks-follow-launcher
if [ -e "$f" ] && [ -f "$o" ] && [ -x "$o" ] && [ -n "$(/usr/bin/find "$f" -type f -mmin -1440 ! -newermt now 2>/dev/null)" ]; then tool=$o; fi
[ -f "$tool" ] && [ -x "$tool" ] || exit 0
# Stop never blocks: exit 2 there holds every turn end, and a CLI older than the plugin
# refuses `hook Stop`. (Claude Code caps the hold: after 8 consecutive Stop blocks with no
# tool call between them it overrides the next and ends the turn, a cap set by
# CLAUDE_CODE_STOP_HOOK_BLOCK_CAP; "Automate actions with hooks", as of 2026-10-14. Eight
# held turn ends are still eight wasted turns, so the shim still never blocks.) PostToolUseFailure and PostToolBatch are treated as Stop: an older
# CLI refuses them too, PostToolBatch's exit 2 stops the agentic loop, and neither has
# anything to say. StopFailure (a turn an API error ended) is fire-and-forget, as Stop. PreCompact keeps the tool's stdout (its block) but never its exit: an
# older CLI refuses `hook PreCompact` with exit 2, which would block every compaction, the
# owner's typed /compact too. Other events keep the tool's exit (PreToolUse may block).
# Measure (packet S49, Amendment 1): the start, empty if `date` fails. The CLI ends the row.
export AGENTIK_SESSION_HOOK_T0="$(date +%s%N 2>/dev/null)"
case "$1" in
  Stop|StopFailure|PostToolUseFailure|PostToolBatch) "$tool" hook "$1" >/dev/null 2>&1; exit 0 ;;
  PreCompact) "$tool" hook "$1"; exit 0 ;;
esac
exec "$tool" hook "$1"
