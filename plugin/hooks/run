#!/bin/sh
# The plugin's one hook shim: hand the event (and stdin) to the tool on PATH, by its new
# name, else its old one, the alias until r2 (agentik-r1 §6.3 c11, packet ruling 7).
# Without either it exits 0 silently; `agentik session doctor` reports the gap.
if command -v agentik-session >/dev/null 2>&1; then tool=agentik-session
elif command -v claude-session >/dev/null 2>&1; then tool=claude-session
else exit 0
fi
# Stop never blocks: exit 2 there holds every turn end, and a CLI older than the plugin
# refuses `hook Stop`. (Claude Code caps the hold: after 8 consecutive Stop blocks with no
# tool call between them it overrides the next and ends the turn, a cap set by
# CLAUDE_CODE_STOP_HOOK_BLOCK_CAP; "Automate actions with hooks", as of 2026-10-14. Eight
# held turn ends are still eight wasted turns, so the shim still never blocks.) PostToolUseFailure and PostToolBatch are treated as Stop: an older
# CLI refuses them too, PostToolBatch's exit 2 stops the agentic loop, and neither has
# anything to say. StopFailure (a turn an API error ended) is fire-and-forget, as Stop. PreCompact keeps the tool's stdout (its block) but never its exit: an
# older CLI refuses `hook PreCompact` with exit 2, which would block every compaction, the
# owner's typed /compact too. Other events keep the tool's exit (PreToolUse may block).
# Measure (packet S49): the tool's wall time and exit, one line to <state>/hooks.jsonl after it
# ends, the state root picked as config.state_dir picks it. Only this plugin's hooks. Two
# `date`s and a printf: no lock, and any failure (no `date` or %N, no state folder, not a
# regular file, an event that is not letters, an unwritable file) writes nothing and says
# nothing. `exit` is the tool's own; the hook's exit and stdout are as they were. The CLI
# bounds the file (harness.rotate): a size here would cost a fork.
t0=$(date +%s%N 2>/dev/null)
case "$1" in
  Stop|StopFailure|PostToolUseFailure|PostToolBatch) "$tool" hook "$1" >/dev/null 2>&1; rc=$?; out=0 ;;
  PreCompact) "$tool" hook "$1"; rc=$?; out=0 ;;
  *) "$tool" hook "$1"; rc=$?; out=$rc ;;
esac
t1=$(date +%s%N 2>/dev/null)
s=${XDG_STATE_HOME:-$HOME/.local/state}
d=$s/agentik-session
[ -e "$d" ] || [ ! -e "$s/claude-code-session" ] || d=$s/claude-code-session
f=$d/hooks.jsonl
case "$t0$t1" in *[!0-9]*) t0= ;; esac
case "$1" in ''|*[!A-Za-z]*) t0= ;; esac
if [ "${#t0}" = 19 ] && [ "${#t1}" = 19 ] && [ "$t1" -ge "$t0" ] && [ -d "$d" ] && { [ ! -e "$f" ] || [ -f "$f" ]; }; then
  umask 077
  { printf '{"event":"%s","ms":%s,"exit":%s}\n' "$1" "$(( (t1 - t0) / 1000000 ))" "$rc" >>"$f"; } 2>/dev/null
fi
exit "$out"
