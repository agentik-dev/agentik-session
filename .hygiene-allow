# .hygiene-allow: <path-glob>: <group>[,<group>]; `*` stays inside one path segment.
# No row allows a private group: the owner's own terms are rewritten (public-r1),
# never excepted. `sibling` is the public plugin names; `person` keeps the name
# only where the packet keeps it.
# LICENSE's copyright line and plugin.json's author field carry the owner's name.
LICENSE: person
plugin/.claude-plugin/plugin.json: sibling,person
# The repo's own name (pyproject's project name, the Makefile's install paths).
pyproject.toml: sibling
Makefile: sibling,renamed
# The design records name the sibling plugins they read and write.
design/*.md: sibling
bugs/*.md: sibling
# ADV6-1's reproduction names a generic mDNS host name and an RFC 1918 address.
