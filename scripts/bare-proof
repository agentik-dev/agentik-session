#!/usr/bin/python3 -B
"""bare-proof: run the plugin as a bare machine would (hq design/04 §7, packet sc1).

Usage: scripts/bare-proof [--transcript PATH] [--runs N] [--keep]

From HEAD it assembles a mock install in a temp home: `git archive HEAD plugin` into
$T/.claude/plugins/cache/agentik/session/<version>/, and, since sc1 moves no code, `git
archive HEAD claude_session` into its lib/, a four-line runner and the launcher of design/04
§2. Every child gets exactly HOME=$T, PATH=/usr/bin:/bin, CLAUDE_PLUGIN_ROOT and
CLAUDE_PLUGIN_DATA, in a temp git repo holding a decoy package; no clone path, no venv, no
launcher on PATH. The repo's shim stays as it is: only the mock's copy gains a line putting
its bin/ first on PATH, so the env stays exact.

The transcript is the newest file over 1 MB under ~/.claude/projects unless --transcript
names one; it is copied into $T by path, and its contents are never printed.

One line per acceptance row of the packet's §3, `ok` or `FAIL`, with its figure; the last
line is `bare-proof: go`, or `bare-proof: stop: <rows>` with exit 1. Latency past design/04
§8's bar (median over 1.25 times 3.12's, or p95 over 2.5 s) is a stop. Exit 2 is the proof's
own setup failing. Stdlib, 3.9.
"""
import argparse
import json
import os
import re
import shutil
import signal
import statistics
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid

EVENTS = ("SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
          "PostToolUseFailure", "PostToolBatch", "PreCompact", "Stop", "StopFailure",
          "SessionEnd")
# The shim's rules (plugin/hooks/run): these four exit 0 whatever the tool says and print
# nothing, PreCompact exits 0 and keeps its stdout, and the others keep the tool's exit, which
# on a fresh session is 0.
SWALLOWED = ("Stop", "StopFailure", "PostToolUseFailure", "PostToolBatch")
MEDIAN_BAR, P95_BAR = 1.25, 2.5
ONE_MB = 1 << 20
FOUND = re.compile(r"(\d+) warnings?")

RUNNER = """import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from claude_session.cli import main
raise SystemExit(main())
"""
# design/04 §2's lines, verbatim but for <no python>, which sc3 settles.
LAUNCHER = """#!/bin/sh
root=${0%/*}/..
py=${AGENTIK_PYTHON:-/usr/bin/python3}; [ -x "$py" ] || py=$(command -v python3) || { [ "$1" = hook ] && exit 0; exit 3; }
exec "$py" -I -X pycache_prefix="${XDG_CACHE_HOME:-$HOME/.cache}/agentik/pycache" "$root/lib/agentik-session" "$@"
"""
DECOY = "raise SystemExit(99)\n"
# AGENTIK_PYTHON for the sentinel pass: the launcher's own flags, the tool under audit.py.
SENTINEL = """#!/bin/sh
printf '%%s\\n' "$HOME" >> %(dir)s/home.log
a=$1; b=$2; c=$3; shift 3
exec /usr/bin/python3 "$a" "$b" "$c" %(dir)s/audit.py "$@"
"""
# The tool's process under an audit hook: any write outside $T, any child without HOME=$T.
AUDIT = """import os, runpy, sys
T, LOG = %(home)r, %(log)r
WRITE = os.O_WRONLY | os.O_RDWR | os.O_CREAT | os.O_TRUNC | os.O_APPEND
busy = []
def note(what):
    busy.append(1)
    fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    os.write(fd, (what + "\\n").encode("utf-8", "replace"))
    os.close(fd)
    busy.pop()
def check(event, path):
    if isinstance(path, bytes):
        path = os.fsdecode(path)
    if not isinstance(path, str):
        return
    full = os.path.realpath(path)
    if full != T and not full.startswith(T + os.sep) and not full.startswith("/dev/"):
        note("%%s %%s" %% (event, full))
PATHS = {"os.mkdir": 1, "os.rename": 2, "os.remove": 1, "os.rmdir": 1, "os.symlink": 2,
         "os.link": 2, "os.truncate": 1, "os.chmod": 1}
def hook(event, args):
    if busy:
        return
    if event == "open":
        if args[2] is not None and args[2] & WRITE or isinstance(args[1], str) and set(args[1]) & set("wax+"):
            check(event, args[0])
    elif event in PATHS:
        for path in args[:PATHS[event]]:
            check(event, path)
    elif event == "subprocess.Popen":
        env = args[3]
        home = os.environ.get("HOME") if env is None else env.get("HOME")
        if home != T:
            note("child HOME %%s: %%s" %% (home, args[0]))
sys.addaudithook(hook)
sys.argv = sys.argv[1:]
runpy.run_path(sys.argv[0], run_name="__main__")
"""


class Proof:
    def __init__(self, args):
        self.args = args
        self.rows, self.failed = [], []
        self.top = self.git("rev-parse", "--show-toplevel")
        common = self.git("rev-parse", "--git-common-dir")
        self.clones = sorted({self.top, os.path.dirname(os.path.realpath(os.path.join(self.top, common)))})
        self.t = os.path.realpath(tempfile.mkdtemp(prefix="bare-proof."))

    def git(self, *argv):
        return subprocess.run(["git", *argv], check=True, capture_output=True, text=True,
                              cwd=os.path.dirname(os.path.realpath(__file__))).stdout.strip()

    def row(self, name, ok, figure):
        print("%-4s %-12s %s" % ("ok" if ok else "FAIL", name, figure), flush=True)
        self.rows.append((name, ok, figure))
        if not ok:
            self.failed.append(name)

    # ---- the mock ------------------------------------------------------------

    def unpack(self, tree, dest, strip):
        """`git archive HEAD <tree>` into dest; strip drops its leading directory."""
        os.makedirs(dest, exist_ok=True)
        p = subprocess.run(["git", "archive", "HEAD", tree], check=True, capture_output=True,
                           cwd=self.top)
        tar = os.path.join(self.t, ".archive.tar")
        with open(tar, "wb") as fh:
            fh.write(p.stdout)
        with tarfile.open(tar) as tf:
            for m in tf.getmembers():
                if strip:
                    m.name = m.name.split("/", 1)[1] if "/" in m.name else "."
                tf.extract(m, dest)
        os.remove(tar)

    def transcript(self):
        src = self.args.transcript
        if not src:
            newest, base = (0, None), os.path.expanduser("~/.claude/projects")
            for d, _, names in os.walk(base):
                for n in names:
                    path = os.path.join(d, n)
                    if not n.endswith(".jsonl"):
                        continue
                    try:
                        st = os.stat(path)
                    except OSError:
                        continue
                    if st.st_size > ONE_MB and (st.st_mtime, path) > newest:
                        newest = (st.st_mtime, path)
            src = newest[1]
        if not src or not os.path.isfile(src):
            raise SystemExit("bare-proof: no transcript over 1 MB; name one with --transcript")
        dest = os.path.join(self.t, ".claude", "projects", "-proof", str(uuid.uuid4()) + ".jsonl")
        os.makedirs(os.path.dirname(dest))
        shutil.copyfile(src, dest)
        return dest

    def assemble(self):
        with open(os.path.join(self.top, "plugin", ".claude-plugin", "plugin.json")) as fh:
            self.version = json.load(fh)["version"]
        self.root = os.path.join(self.t, ".claude", "plugins", "cache", "agentik", "session", self.version)
        self.unpack("plugin", self.root, True)
        self.unpack("claude_session", os.path.join(self.root, "lib"), False)
        for rel, text in (("lib/agentik-session", RUNNER), ("bin/agentik-session", LAUNCHER)):
            path = os.path.join(self.root, rel)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as fh:
                fh.write(text)
            os.chmod(path, 0o755)
        self.tool = os.path.join(self.root, "bin", "agentik-session")
        shim = os.path.join(self.root, "hooks", "run")
        with open(shim) as fh:
            head, rest = fh.read().split("\n", 1)
        with open(shim, "w") as fh:
            fh.write(head + '\nPATH="$CLAUDE_PLUGIN_ROOT/bin:$PATH"\n' + rest)
        self.shim = shim
        self.data = os.path.join(self.t, ".claude", "plugins", "data", "session-agentik")
        os.makedirs(self.data)
        self.env = {"HOME": self.t, "PATH": "/usr/bin:/bin", "CLAUDE_PLUGIN_ROOT": self.root,
                    "CLAUDE_PLUGIN_DATA": self.data}
        self.script = self.transcript()
        self.repo = os.path.join(self.t, "repo")
        os.makedirs(os.path.join(self.repo, "claude_session"))
        repo_git = ["git", "-c", "user.name=proof", "-c", "user.email=proof"]
        for argv in (["git", "init", "-q"], repo_git + ["commit", "-q", "--allow-empty", "-m", "proof"]):
            subprocess.run(argv, check=True, cwd=self.repo, env=self.env, capture_output=True)
        for rel in ("claude_session/__init__.py", "claude_session/__main__.py", "json.py"):
            with open(os.path.join(self.repo, rel), "w") as fh:
                fh.write(DECOY)
        with open(os.path.join(self.repo, ".git", "info", "exclude"), "a") as fh:
            fh.write("claude_session\njson.py\n")

    # ---- the children --------------------------------------------------------

    def payload(self, event, sid):
        p = {"session_id": sid, "transcript_path": self.script, "cwd": self.repo,
             "hook_event_name": event, "permission_mode": "default"}
        p.update({
            "SessionStart": {"source": "startup", "model": "claude-opus-5-5"},
            "UserPromptSubmit": {"prompt": "proof"},
            "PreToolUse": {"tool_name": "Bash", "tool_input": {"command": "true"}, "tool_use_id": "t1"},
            "PostToolUse": {"tool_name": "Bash", "tool_input": {"command": "true"},
                            "tool_response": {"stdout": ""}, "tool_use_id": "t1"},
            "PostToolUseFailure": {"tool_name": "Bash", "tool_input": {"command": "false"},
                                   "error": "exit 1", "tool_use_id": "t2"},
            "PostToolBatch": {"tool_calls": []},
            "PreCompact": {"trigger": "manual", "custom_instructions": ""},
            "Stop": {"stop_hook_active": False},
            "StopFailure": {"error": "rate_limit"},
            "SessionEnd": {"reason": "other"},
        }[event])
        return json.dumps(p)

    def hook(self, event, sid, extra=None):
        return subprocess.run([self.shim, event], input=self.payload(event, sid), text=True,
                              capture_output=True, cwd=self.repo, timeout=60,
                              env=dict(self.env, **(extra or {})))

    def tool_run(self, argv, extra=None, stdin="", timeout=180):
        return subprocess.run([self.tool, *argv], input=stdin, text=True, capture_output=True,
                              cwd=self.repo, timeout=timeout, env=dict(self.env, **(extra or {})))

    def events(self, sid, extra=None):
        """The ten events: (all as the rules say, what went wrong)."""
        wrong = []
        for event in EVENTS:
            r = self.hook(event, sid, extra)
            if r.returncode != 0:
                wrong.append("%s exit %d" % (event, r.returncode))
            if event in SWALLOWED and r.stdout:
                wrong.append("%s printed" % event)
            if event == "SessionStart":
                try:
                    json.loads(r.stdout)
                except ValueError:
                    wrong.append("SessionStart's stdout is not JSON")
        return wrong

    def failing_tool(self):
        """The shim's other half: a tool exiting 1 is swallowed for these five, kept for the rest."""
        wrong = []
        for event in EVENTS:
            want = 0 if event in SWALLOWED + ("PreCompact",) else 1
            r = self.hook(event, "failing", {"AGENTIK_PYTHON": "/usr/bin/false"})
            if r.returncode != want:
                wrong.append("%s exit %d under a failing tool, not %d" % (event, r.returncode, want))
        return wrong

    def admission(self, sid, extra=None):
        line = json.dumps({"kind": "start", "interactive": False})
        r = self.tool_run(["admission", "record", "--session", sid], extra, stdin=line)
        ledger = [os.path.join(d, n) for d, _, ns in os.walk(os.path.join(self.t, ".local", "state"))
                  for n in ns if n == "ledger.jsonl" and os.path.basename(d) == "admission"]
        lines = 0
        for path in ledger:
            with open(path, errors="replace") as fh:
                lines += sum(1 for l in fh if sid in l)
        return r.returncode, lines, r.stderr.strip()[:160]

    def forms(self, tag, extra=None):
        """The two named forms. Returns [(what, exit, detail)]."""
        out = []
        r = self.tool_run(["charter", "open", "--dir", "history/sittings", "proof " + tag], extra)
        charter = r.stdout.strip().splitlines()[0] if r.returncode == 0 and r.stdout.strip() else ""
        out.append(("charter open", r.returncode, r.stderr.strip()[:160]))
        r = self.tool_run(["charter", "close", "--exit", "X", charter], extra)
        out.append(("charter close --exit X FILE", r.returncode, r.stderr.strip()[:160]))
        r = self.tool_run(["gate", "run", self.repo, "--label", "t", "--", "true"], extra)
        out.append(("gate run R --label t -- true", r.returncode, r.stderr.strip()[:160]))
        gate = r.stdout.split()[1] if r.returncode == 0 and len(r.stdout.split()) > 1 else "none"
        r = self.tool_run(["gate", "wait", gate, "--timeout", "150"], extra)
        out.append(("gate wait", r.returncode, (r.stdout + r.stderr).strip()[:160]))
        return out

    # ---- the rows ------------------------------------------------------------

    def bytecode(self):
        prefix = os.path.join(self.t, ".cache", "agentik", "pycache")
        pyc = sum(n.endswith(".pyc") for _, _, ns in os.walk(prefix) for n in ns)
        beside = [os.path.join(d, n) for d, ds, ns in os.walk(self.root) for n in ds + ns
                  if n == "__pycache__" or n.endswith(".pyc")]
        self.row("bytecode", pyc > 0 and not beside,
                 "%d .pyc under the prefix, %d beside the sources" % (pyc, len(beside)))

    def clone_paths(self, label):
        """Every file under $T naming a clone, the copied transcript excepted, and the bytecode
        of the venv the 3.12 baseline runs from: AGENTIK_PYTHON names it, and nothing ships it."""
        needles = [c.encode() for c in self.clones]
        prefix = os.path.join(self.t, ".cache", "agentik", "pycache") + os.sep
        hits, baseline = [], 0
        for d, ds, ns in os.walk(self.t):
            for n in ns:
                path = os.path.join(d, n)
                if path == self.script or os.path.islink(path):
                    continue
                if path.startswith(prefix) and os.sep + ".venv" + os.sep in path and "cpython-312" in n:
                    baseline += 1
                    continue
                try:
                    with open(path, "rb") as fh:
                        data = fh.read()
                except OSError:
                    continue
                if any(x in data for x in needles):
                    hits.append(os.path.relpath(path, self.t))
        self.row(label, not hits, "%d files name a clone%s; the transcript and %d .pyc of the 3.12 baseline's venv excepted"
                 % (len(hits), ": " + ", ".join(hits[:8]) if hits else "", baseline))

    def latency(self):
        py312 = os.path.join(self.top, ".venv", "bin", "python")
        both = {"3.9": ("lat-39", None), "3.12": ("lat-312", {"AGENTIK_PYTHON": py312})}
        times = {k: [] for k in both}
        first = {}
        for k, (sid, extra) in both.items():
            t0 = time.perf_counter()
            self.hook("PostToolUse", sid, extra)
            first[k] = time.perf_counter() - t0
        for i in range(self.args.runs):
            for k in (("3.9", "3.12") if i % 2 == 0 else ("3.12", "3.9")):
                sid, extra = both[k]
                t0 = time.perf_counter()
                r = self.hook("PostToolUse", sid, extra)
                times[k].append(time.perf_counter() - t0)
                if r.returncode != 0:
                    self.row("latency", False, "%s exit %d" % (k, r.returncode))
                    return
        fig = {}
        for k, ts in times.items():
            ts.sort()
            fig[k] = (statistics.median(ts), ts[max(0, int(0.95 * len(ts) + 0.999) - 1)])
        ratio = fig["3.9"][0] / fig["3.12"][0]
        ok = ratio <= MEDIAN_BAR and fig["3.9"][1] <= P95_BAR
        self.row("latency", ok,
                 "%d hooks each: 3.9 median %.0f ms p95 %.0f ms; 3.12 median %.0f ms p95 %.0f ms; ratio %.2f (bar %.2f, p95 bar %.1f s); first hook %.0f against %.0f ms, 3.12's cold; load %.1f"
                 % (self.args.runs, fig["3.9"][0] * 1e3, fig["3.9"][1] * 1e3, fig["3.12"][0] * 1e3,
                    fig["3.12"][1] * 1e3, ratio, MEDIAN_BAR, P95_BAR, first["3.9"] * 1e3,
                    first["3.12"] * 1e3, os.getloadavg()[0]))

    def validate(self):
        claude = shutil.which("claude")
        if not claude:
            self.row("validate", False, "no claude on PATH")
            return
        live = os.path.join(self.t, "live", "plugin")
        self.unpack("plugin", live, True)
        outs = {}
        for name, path in (("live", live), ("mock", self.root)):
            env = {"HOME": self.t, "PATH": os.environ.get("PATH", "/usr/bin:/bin")}
            r = subprocess.run([claude, "plugin", "validate", path], text=True, capture_output=True,
                               cwd=self.t, env=env, timeout=60)
            outs[name] = (r.returncode, (r.stdout + r.stderr).replace(path, "<root>"))
        warnings = {k: sum(FOUND.findall(v[1]) and [int(FOUND.findall(v[1])[0])] or [-1]) for k, v in outs.items()}
        same = outs["live"][1] == outs["mock"][1] and outs["live"][0] == outs["mock"][0]
        tail = ""
        if not same:
            a, b = outs["live"][1].splitlines(), outs["mock"][1].splitlines()
            tail = "; first difference: " + " / ".join(
                next(("%s | %s" % (x, y) for x, y in zip(a, b) if x != y), "length"))[:200]
        self.row("validate", same, "exit %d and %d, warnings %d and %d, %s%s" % (
            outs["live"][0], outs["mock"][0], warnings["live"], warnings["mock"],
            "the outputs identical" if same else "the outputs differ", tail))

    def sentinel(self):
        """HOME reached every child; nothing wrote outside $T. The detector proves itself first."""
        d = os.path.join(self.t, "sentinel")
        os.makedirs(d)
        log, homes = os.path.join(d, "outside.log"), os.path.join(d, "home.log")
        with open(os.path.join(d, "audit.py"), "w") as fh:
            fh.write(AUDIT % {"home": self.t, "log": log})
        py = os.path.join(d, "python")
        with open(py, "w") as fh:
            fh.write(SENTINEL % {"dir": d})
        os.chmod(py, 0o755)
        extra = {"AGENTIK_PYTHON": py}
        # A write it must see: the audit hook fires before the call, which fails on no directory.
        probe = os.path.join(d, "probe.py")
        with open(probe, "w") as fh:
            fh.write("try:\n    open('/nonexistent-bare-proof/x', 'w')\nexcept OSError:\n    pass\n")
        subprocess.run(["/usr/bin/python3", "-I", os.path.join(d, "audit.py"), probe], env=self.env, cwd=self.repo)
        seen = os.path.exists(log) and "/nonexistent-bare-proof" in open(log).read()
        if not seen:
            self.row("live state", False, "the detector did not see its own probe")
            return
        os.remove(log)
        wrong = self.events("sentinel", extra)
        code, lines, _ = self.admission("sentinel", extra)
        if code or not lines:
            wrong.append("admission exit %d" % code)
        wrong += ["%s exit %d" % (w, c) for w, c, _ in self.forms("sentinel", extra) if c]
        job = os.path.join(self.repo, ".home-seen")
        r = self.tool_run(["gate", "run", self.repo, "--label", "home", "--", "/bin/sh", "-c",
                           'printf %s "$HOME" > .home-seen'], extra)
        gate = r.stdout.split()[1] if r.returncode == 0 and len(r.stdout.split()) > 1 else "none"
        self.tool_run(["gate", "wait", gate, "--timeout", "150"], extra)
        seen_job = open(job).read() if os.path.exists(job) else None
        with open(homes) as fh:
            seen_homes = set(fh.read().split("\n")) - {""}
        outside = open(log).read().splitlines() if os.path.exists(log) else []
        real = os.path.realpath(os.path.expanduser("~/.cache/agentik"))
        grew = os.path.exists(real) and not self.cache_there
        ok = seen_homes == {self.t} and seen_job == self.t and not outside and not wrong and not grew
        detail = "HOME at every launch, in the gate's job; %d writes or children outside $T" % len(outside)
        if not ok:
            detail += "; homes %d, job %s, wrong %s, default prefix grew %s; %s" % (
                len(seen_homes), seen_job == self.t, wrong[:3], grew, outside[:4])
        self.row("live state", ok, detail)

    def stop_serve(self):
        """The temp home's gate runner only, by the pid in its own runner.json; it idles out."""
        state = os.path.join(self.t, ".local", "state")
        for d, _, ns in os.walk(state):
            if "runner.json" not in ns:
                continue
            try:
                with open(os.path.join(d, "runner.json")) as fh:
                    pid = int(json.load(fh)["pid"])
            except (OSError, ValueError, KeyError, TypeError):
                continue
            ps = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, text=True)
            if self.t in ps.stdout:
                os.kill(pid, signal.SIGTERM)
                for _ in range(50):
                    if subprocess.run(["ps", "-p", str(pid)], capture_output=True).returncode:
                        break
                    time.sleep(0.1)

    def run(self):
        self.cache_there = os.path.exists(os.path.expanduser("~/.cache/agentik"))
        self.assemble()
        print("bare-proof: %s at %s, transcript %d MB, under %s" % (
            self.version, self.git("rev-parse", "--short", "HEAD"),
            os.path.getsize(self.script) >> 20, sys.version.split()[0]), flush=True)
        wrong = self.events("first") + self.failing_tool()
        self.row("ten events", not wrong, "%d events, %s" % (len(EVENTS), wrong or "as the shim's rules say, under a tool that exits 0 and one that exits 1; SessionStart's stdout JSON"))
        self.bytecode()
        code, lines, err = self.admission("first")
        self.row("admission", code == 0 and lines == 1, "exit %d, %d line on the ledger under $T%s" % (code, lines, "; " + err if err else ""))
        forms = self.forms("first")
        states = [d for d in os.listdir(os.path.join(self.t, ".local", "state"))]
        self.row("two forms", all(c == 0 for _, c, _ in forms),
                 "; ".join("%s exit %d" % (w, c) + (" (%s)" % e if c and e else "") for w, c, e in forms)
                 + "; state under $T: " + ", ".join(states))
        self.sentinel()
        self.validate()
        self.latency()
        self.stop_serve()
        self.clone_paths("no clone path")
        if self.failed:
            print("bare-proof: stop: " + ", ".join(self.failed))
            return 1
        print("bare-proof: go")
        return 0


def main():
    ap = argparse.ArgumentParser(prog="bare-proof", description=__doc__.splitlines()[0])
    ap.add_argument("--transcript", help="default: the newest file over 1 MB under ~/.claude/projects")
    ap.add_argument("--runs", type=int, default=25, help="hooks per interpreter (default 25)")
    ap.add_argument("--keep", action="store_true", help="keep the temp home and print it")
    args = ap.parse_args()
    proof = Proof(args)
    try:
        return proof.run()
    finally:
        proof.stop_serve()
        if args.keep:
            print("kept: " + proof.t)
        else:
            shutil.rmtree(proof.t, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
